FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}

application buoyantBoussinesqSimpleFoam;
startFrom startTime;
startTime 0;
stopAt endTime;
endTime 5000.0;
deltaT 1;
writeControl timeStep;
writeInterval 500.0;
purgeWrite 2;
writeFormat ascii;
writePrecision 12;
writeCompression off;
timeFormat general;
timePrecision 12;
runTimeModifiable true;

functions
{
    centreline
    {
        type sets;
        libs (sampling);
        writeControl writeTime;
        setFormat raw;
        interpolationScheme cellPoint;
        fields (U);
        sets
        (
            vertical
            {
                type uniform;
                axis y;
                start (0.05 0 0.025);
                end (0.05 0.1 0.025);
                nPoints 64;
            }
            horizontal
            {
                type uniform;
                axis x;
                start (0 0.05 0.025);
                end (0.1 0.05 0.025);
                nPoints 64;
            }
        );
    }
    line_1
    {
        type sets;
        libs (sampling);
        writeControl writeTime;
        setFormat raw;
        interpolationScheme cellPoint;
        fields (U);
        sets
        (
            line
            {
                type uniform;
                axis xyz;
                start (0.0 0.05 0.025);
                end (0.1 0.05 0.025);
                nPoints 16;
            }
        );
    }
    line_2
    {
        type sets;
        libs (sampling);
        writeControl writeTime;
        setFormat raw;
        interpolationScheme cellPoint;
        fields (U);
        sets
        (
            line
            {
                type uniform;
                axis xyz;
                start (0.05 0.0 0.025);
                end (0.05 0.1 0.025);
                nPoints 16;
            }
        );
    }
    heat_grad
    {
        type grad;
        libs (fieldFunctionObjects);
        field T;
        result gradT;
        writeControl none;
    }
    surface_1
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        writeControl timeStep;
        writeInterval 1;
        log no;
        writeFields no;
        regionType patch;
        name isothermal1;
        operation areaIntegrate;
        fields (gradT);
    }
    surface_2
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        writeControl timeStep;
        writeInterval 1;
        log no;
        writeFields no;
        regionType patch;
        name isothermal2;
        operation areaIntegrate;
        fields (gradT);
    }
    balance_fixedWalls
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        writeControl timeStep;
        writeInterval 1;
        log no;
        writeFields no;
        regionType patch;
        name fixedWalls;
        operation sum;
        fields (phi);
    }
    balance_isothermal1
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        writeControl timeStep;
        writeInterval 1;
        log no;
        writeFields no;
        regionType patch;
        name isothermal1;
        operation sum;
        fields (phi);
    }
    balance_isothermal2
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        writeControl timeStep;
        writeInterval 1;
        log no;
        writeFields no;
        regionType patch;
        name isothermal2;
        operation sum;
        fields (phi);
    }
}
