{
  "$defs": {
    "BoundaryCondition": {
      "additionalProperties": false,
      "description": "One named boundary: the box faces it covers, its kind, and a speed where the kind needs one.",
      "properties": {
        "faces": {
          "items": {
            "$ref": "#/$defs/Face"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/BoundaryKind"
        },
        "profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/InletProfile"
            },
            {
              "type": "null"
            }
          ],
          "description": "The shape of the inflow across an inlet on a left or right face. The velocity is the mean\nspeed; the peak of a parabola is 1.5 times it. Left out for a flat profile."
        },
        "thermal": {
          "anyOf": [
            {
              "$ref": "#/$defs/ThermalCondition"
            },
            {
              "type": "null"
            }
          ],
          "description": "The temperature condition of a wall."
        },
        "velocity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "description": "Required for a velocity inlet and a moving wall; absent for every other kind."
        }
      },
      "required": [
        "faces",
        "kind"
      ],
      "type": "object"
    },
    "BoundaryKind": {
      "description": "What a boundary does to the flow.",
      "oneOf": [
        {
          "const": "VelocityInlet",
          "description": "Fixed inflow velocity. `velocity` is the speed into the domain, along the inward normal.",
          "type": "string"
        },
        {
          "const": "PressureOutlet",
          "description": "Outflow at gauge pressure zero in kinematic units. It has no value field.",
          "type": "string"
        },
        {
          "const": "NoSlipWall",
          "description": "Wall with zero velocity at the wall.",
          "type": "string"
        },
        {
          "const": "SlipWall",
          "description": "Wall without friction.",
          "type": "string"
        },
        {
          "const": "MovingWall",
          "description": "Wall that moves in its own plane. `velocity` is the tangential speed along +x (bottom\nand top faces) or +y (left and right faces).",
          "type": "string"
        },
        {
          "const": "Symmetry",
          "description": "Mirror plane.",
          "type": "string"
        }
      ]
    },
    "Buoyancy": {
      "additionalProperties": false,
      "description": "Boussinesq buoyancy: the density varies linearly with temperature in the gravity term only.",
      "properties": {
        "beta": {
          "description": "Thermal expansion coefficient in 1/K.",
          "format": "double",
          "type": "number"
        },
        "gravity": {
          "description": "Gravity in m/s2, acting along -y.",
          "format": "double",
          "type": "number"
        },
        "prandtl": {
          "format": "double",
          "type": "number"
        },
        "reference_temperature": {
          "$ref": "#/$defs/Quantity"
        },
        "turbulent_prandtl": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "gravity",
        "beta",
        "reference_temperature",
        "prandtl",
        "turbulent_prandtl"
      ],
      "type": "object"
    },
    "Convergence": {
      "additionalProperties": false,
      "properties": {
        "U": {
          "format": "double",
          "type": "number"
        },
        "p": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "p",
        "U"
      ],
      "type": "object"
    },
    "Domain": {
      "additionalProperties": false,
      "properties": {
        "length_x": {
          "$ref": "#/$defs/Quantity"
        },
        "length_y": {
          "$ref": "#/$defs/Quantity"
        },
        "length_z": {
          "$ref": "#/$defs/Quantity"
        },
        "open": {
          "default": false,
          "description": "True when the box has open (inlet or outlet) faces. A closed domain has only walls.\nClosed unless stated.",
          "type": "boolean"
        },
        "shape": {
          "anyOf": [
            {
              "$ref": "#/$defs/Shape"
            },
            {
              "type": "null"
            }
          ],
          "description": "A shape other than the plain box. Left out for a box."
        }
      },
      "required": [
        "length_x",
        "length_y",
        "length_z"
      ],
      "type": "object"
    },
    "Face": {
      "description": "A face of the domain: left (x min), right (x max), bottom (y min) or top (y max), and the\nsurface of the cylinder in a cylinder channel. The front and back faces are always empty\n(two-dimensional case).",
      "oneOf": [
        {
          "enum": [
            "XMin",
            "XMax",
            "YMin",
            "YMax"
          ],
          "type": "string"
        },
        {
          "const": "Obstacle",
          "description": "The surface of the cylinder of a cylinder channel; no other domain has it.",
          "type": "string"
        }
      ]
    },
    "Fluid": {
      "additionalProperties": false,
      "properties": {
        "kinematic_viscosity": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "kinematic_viscosity"
      ],
      "type": "object"
    },
    "ForceMonitor": {
      "additionalProperties": false,
      "description": "Drag and lift coefficients of one wall boundary. The coefficients are the force over\n1/2 times the reference velocity squared times the reference length (per unit depth).",
      "properties": {
        "boundary": {
          "type": "string"
        },
        "reference_length": {
          "$ref": "#/$defs/Quantity"
        },
        "reference_velocity": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "boundary",
        "reference_velocity",
        "reference_length"
      ],
      "type": "object"
    },
    "Grading": {
      "additionalProperties": false,
      "description": "Symmetric wall grading. Each ratio is the growth of one cell over the next from a wall toward\nthe middle of the domain, from 1 (even cells) up to 1.5. An axis left out is not graded, and\na graded axis needs an even cell count.",
      "properties": {
        "x": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "y": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "InitMode": {
      "description": "How the fields start.",
      "oneOf": [
        {
          "const": "uniform",
          "description": "The same values everywhere.",
          "type": "string"
        },
        {
          "const": "potential",
          "description": "A potential-flow solution of the velocity field.",
          "type": "string"
        }
      ]
    },
    "InletProfile": {
      "description": "How the inflow speed varies across an inlet.",
      "oneOf": [
        {
          "const": "uniform",
          "description": "The same speed everywhere on the inlet.",
          "type": "string"
        },
        {
          "const": "parabolic",
          "description": "Zero at the walls and 1.5 times the mean speed in the middle of the inlet.",
          "type": "string"
        }
      ]
    },
    "LineMonitor": {
      "additionalProperties": false,
      "description": "A straight line of evenly spaced samples; `samples` counts the points, ends included.",
      "properties": {
        "field": {
          "$ref": "#/$defs/MonitorField"
        },
        "samples": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "x0": {
          "$ref": "#/$defs/Quantity"
        },
        "x1": {
          "$ref": "#/$defs/Quantity"
        },
        "y0": {
          "$ref": "#/$defs/Quantity"
        },
        "y1": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "x0",
        "y0",
        "x1",
        "y1",
        "samples",
        "field"
      ],
      "type": "object"
    },
    "MeshSpec": {
      "additionalProperties": false,
      "properties": {
        "cells_x": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "cells_y": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "cells_z": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "grading": {
          "anyOf": [
            {
              "$ref": "#/$defs/Grading"
            },
            {
              "type": "null"
            }
          ],
          "description": "Wall grading: cells shrink toward the walls on the axes given. Box domains only."
        },
        "level": {
          "description": "Refinement level, 0 to 4. The cell counts above are the level 0 counts; level L\nmultiplies the counts along x and y by 2^L and leaves z alone. Left out for level 0.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cells_x",
        "cells_y",
        "cells_z"
      ],
      "type": "object"
    },
    "MonitorField": {
      "description": "The field a probe or line reads.",
      "enum": [
        "velocity",
        "pressure"
      ],
      "type": "string"
    },
    "Monitors": {
      "additionalProperties": false,
      "description": "What to watch while the solver runs. Every monitor is keyed by the user's own label; the\nlabel is shown to people and never written into a case (the case names monitors by their\nposition). Labels match `[A-Za-z][A-Za-z0-9_-]{0,31}`. A study that lists no probe, line or\nsurface is watched at five default velocity points.",
      "properties": {
        "centreline_u_sample_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "forces": {
          "additionalProperties": {
            "$ref": "#/$defs/ForceMonitor"
          },
          "description": "Force coefficients on a wall, at most 4.",
          "type": "object"
        },
        "lines": {
          "additionalProperties": {
            "$ref": "#/$defs/LineMonitor"
          },
          "description": "Straight sample lines, at most 8.",
          "type": "object"
        },
        "probes": {
          "additionalProperties": {
            "$ref": "#/$defs/Probe"
          },
          "description": "Point probes, at most 16.",
          "type": "object"
        },
        "settle": {
          "anyOf": [
            {
              "$ref": "#/$defs/SettleSettings"
            },
            {
              "type": "null"
            }
          ],
          "description": "How steady a monitored quantity must be to count as settled. It judges a run and does not\nchange what is run."
        },
        "surfaces": {
          "additionalProperties": {
            "$ref": "#/$defs/SurfaceMonitor"
          },
          "description": "Integrals over a named boundary, at most 8.",
          "type": "object"
        }
      },
      "required": [
        "centreline_u_sample_count"
      ],
      "type": "object"
    },
    "Physics": {
      "additionalProperties": false,
      "description": "The physics of the run. A study that states none of it is steady, laminar, without buoyancy\nand started from a uniform field.",
      "properties": {
        "buoyancy": {
          "anyOf": [
            {
              "$ref": "#/$defs/Buoyancy"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present means the Boussinesq buoyancy model is on."
        },
        "init": {
          "$ref": "#/$defs/InitMode"
        },
        "time": {
          "$ref": "#/$defs/TimeMode"
        },
        "turbulence": {
          "$ref": "#/$defs/Turbulence"
        }
      },
      "type": "object"
    },
    "Probe": {
      "additionalProperties": false,
      "description": "A point in the plane of the case (the case is flat, so a point has x and y only).",
      "properties": {
        "boundary": {
          "description": "The boundary the point lies on, for a reading at a wall. Left out for a point in the\nflow.",
          "type": [
            "string",
            "null"
          ]
        },
        "field": {
          "$ref": "#/$defs/MonitorField"
        },
        "x": {
          "$ref": "#/$defs/Quantity"
        },
        "y": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "x",
        "y",
        "field"
      ],
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "value": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "type": "object"
    },
    "RawBackend": {
      "description": "The backend a raw override is written for. The dictionary syntax differs between backends, so\nan override only runs on the backend it names.",
      "enum": [
        "esi",
        "foundation"
      ],
      "type": "string"
    },
    "RawOverride": {
      "additionalProperties": false,
      "description": "One dictionary entry to set in the written case.",
      "properties": {
        "backend": {
          "$ref": "#/$defs/RawBackend",
          "description": "The backend this override is written for."
        },
        "entry": {
          "description": "The entry inside the file: block names then the entry, joined by `/`, for example\n`relaxationFactors/equations/U`.",
          "type": "string"
        },
        "file": {
          "description": "The case file, for example `system/fvSolution`.",
          "type": "string"
        },
        "value": {
          "description": "The text that goes after the entry name.",
          "type": "string"
        }
      },
      "required": [
        "backend",
        "file",
        "entry",
        "value"
      ],
      "type": "object"
    },
    "SettleSettings": {
      "additionalProperties": false,
      "description": "Optional tolerances for judging a monitored quantity settled. A member left out uses the\nbuilt-in value.",
      "properties": {
        "drift_rel": {
          "description": "The largest drift across the tail, relative to its mean (above 0, up to 1).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "spread_rel": {
          "description": "The largest spread of the tail, relative to its mean (above 0, up to 1).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "tail_floor": {
          "description": "The fewest iterations the judged tail may hold (5 to 100000).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "tail_fraction": {
          "description": "The share of the iterations, counted from the end, that is judged (above 0, up to 1).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Shape": {
      "description": "The outline of the domain when it is not a plain box. The domain lengths still give the\nbounding box, `[0, length_x]` by `[0, length_y]`; a shape needs an open domain.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A channel that widens by a step. The step is at x = `upstream_length`; upstream of it the\nchannel spans y from `step_height` to `length_y`, downstream it spans the full height.",
          "properties": {
            "kind": {
              "const": "backward_step",
              "type": "string"
            },
            "startup_length": {
              "$ref": "#/$defs/Quantity",
              "description": "Length of a slip section at the inlet, from 0 (none) up to `upstream_length`."
            },
            "step_height": {
              "$ref": "#/$defs/Quantity"
            },
            "upstream_length": {
              "$ref": "#/$defs/Quantity"
            }
          },
          "required": [
            "kind",
            "step_height",
            "upstream_length",
            "startup_length"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A channel with a round cylinder across the flow. The surface of the cylinder is the face\n`Obstacle`. The cylinder and a clearance of one diameter around it must lie inside the domain.",
          "properties": {
            "centre_x": {
              "$ref": "#/$defs/Quantity"
            },
            "centre_y": {
              "$ref": "#/$defs/Quantity"
            },
            "diameter": {
              "$ref": "#/$defs/Quantity"
            },
            "kind": {
              "const": "cylinder_channel",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "diameter",
            "centre_x",
            "centre_y"
          ],
          "type": "object"
        }
      ]
    },
    "SolverControl": {
      "additionalProperties": false,
      "properties": {
        "convergence": {
          "$ref": "#/$defs/Convergence",
          "default": {
            "U": 1e-6,
            "p": 1e-6
          }
        },
        "end_time": {
          "$ref": "#/$defs/Quantity",
          "description": "Steady SIMPLE iteration count, represented as solver pseudo-time in seconds."
        },
        "solver": {
          "$ref": "#/$defs/SolverKind"
        },
        "write_interval": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "solver",
        "end_time",
        "write_interval"
      ],
      "type": "object"
    },
    "SolverKind": {
      "oneOf": [
        {
          "const": "SimpleLaminar",
          "description": "Steady, laminar, no buoyancy. Any physics that differs is refused.",
          "type": "string"
        },
        {
          "const": "FromPhysics",
          "description": "The solver follows the study's physics.",
          "type": "string"
        }
      ]
    },
    "SurfaceMonitor": {
      "additionalProperties": false,
      "description": "A quantity integrated over one boundary of the study, named by its label.",
      "properties": {
        "boundary": {
          "type": "string"
        },
        "quantity": {
          "$ref": "#/$defs/SurfaceQuantity"
        }
      },
      "required": [
        "boundary",
        "quantity"
      ],
      "type": "object"
    },
    "SurfaceQuantity": {
      "description": "What a surface monitor reports over its boundary.",
      "oneOf": [
        {
          "const": "flux",
          "description": "The volumetric flux through the boundary.",
          "type": "string"
        },
        {
          "const": "pressure_average",
          "description": "The area-averaged pressure on the boundary.",
          "type": "string"
        },
        {
          "const": "pressure_integral",
          "description": "The area-integrated pressure on the boundary.",
          "type": "string"
        },
        {
          "const": "heat_flux",
          "description": "The area integral of the temperature gradient along the boundary's axis, in K m. The\nboundary needs a thermal condition.",
          "type": "string"
        }
      ]
    },
    "ThermalCondition": {
      "description": "The temperature condition of a wall.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The wall is held at this temperature.",
          "properties": {
            "kind": {
              "const": "fixed_temperature",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Quantity"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "No heat passes through the wall.",
          "properties": {
            "kind": {
              "const": "adiabatic",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "TimeMode": {
      "description": "Whether the run marches in time.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Iterate to a steady state.",
          "properties": {
            "mode": {
              "const": "steady",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "March in time. `delta_t` is the step at mesh level 0; each level halves it.",
          "properties": {
            "delta_t": {
              "$ref": "#/$defs/Quantity"
            },
            "mode": {
              "const": "transient",
              "type": "string"
            }
          },
          "required": [
            "mode",
            "delta_t"
          ],
          "type": "object"
        }
      ]
    },
    "Turbulence": {
      "additionalProperties": false,
      "description": "The turbulence model and the inflow values it needs.",
      "properties": {
        "intensity": {
          "description": "Turbulence intensity of the inflow, above 0 and at most 1.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "model": {
          "$ref": "#/$defs/TurbulenceModel"
        },
        "reference_velocity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "description": "The speed the inflow values are built from. Left out to use the speed of the inlet or\nmoving wall."
        },
        "viscosity_ratio": {
          "description": "Ratio of the turbulent to the molecular viscosity of the inflow, above 0.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "TurbulenceModel": {
      "description": "The flow model: none (laminar) or one of three Reynolds-averaged models.",
      "enum": [
        "laminar",
        "k_omega_sst",
        "realizable_ke",
        "rng_k_epsilon"
      ],
      "type": "string"
    },
    "Unit": {
      "enum": [
        "m",
        "mm",
        "m/s",
        "m2/s",
        "Pa",
        "K",
        "s",
        "1",
        "rpm"
      ],
      "type": "string"
    }
  },
  "$id": "urn:cfdcraft:schema:study:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A unit-carrying study, schema version 1.",
  "properties": {
    "boundary_conditions": {
      "additionalProperties": {
        "$ref": "#/$defs/BoundaryCondition"
      },
      "description": "Boundaries keyed by the user's own label. The label appears in diagnostics only and\nnever in the written case. Labels match `[A-Za-z][A-Za-z0-9_-]{0,31}`.",
      "type": "object"
    },
    "domain": {
      "$ref": "#/$defs/Domain"
    },
    "fluid": {
      "$ref": "#/$defs/Fluid"
    },
    "mesh": {
      "$ref": "#/$defs/MeshSpec"
    },
    "monitors": {
      "$ref": "#/$defs/Monitors"
    },
    "physics": {
      "anyOf": [
        {
          "$ref": "#/$defs/Physics"
        },
        {
          "type": "null"
        }
      ],
      "description": "Steady or transient, the turbulence model, buoyancy and how the flow starts. Left out\nfor the plain steady laminar study."
    },
    "raw_overrides": {
      "additionalProperties": {
        "$ref": "#/$defs/RawOverride"
      },
      "description": "Raw dictionary overrides keyed by a label (same naming rule as boundaries). For expert\nuse: each one sets a solver dictionary entry the study does not model. They show in\ndiffs and are part of the result's identity.",
      "type": "object"
    },
    "schema_version": {
      "const": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "solver": {
      "$ref": "#/$defs/SolverControl"
    }
  },
  "required": [
    "schema_version",
    "domain",
    "fluid",
    "boundary_conditions",
    "mesh",
    "solver",
    "monitors"
  ],
  "title": "CFDCraft study.json, schema 1",
  "type": "object"
}
