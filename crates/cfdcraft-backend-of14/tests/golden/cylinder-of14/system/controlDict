FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}

solver incompressibleFluid;
startFrom startTime;
startTime 0;
stopAt endTime;
endTime 8.0;
deltaT 0.001;
adjustTimeStep no;
writeControl runTime;
writeInterval 0.5;
purgeWrite 2;
writeFormat ascii;
writePrecision 12;
writeCompression off;
timeFormat general;
timePrecision 12;
runTimeModifiable true;

functions
{
    centreline
    {
        type sets;
        libs ("libsampling.so");
        writeControl writeTime;
        setFormat raw;
        interpolationScheme cellPoint;
        fields (U);
        sets
        {
            vertical
            {
                type lineUniform;
                axis y;
                start (1.1 0 0.005);
                end (1.1 0.41 0.005);
                nPoints 64;
            }
            horizontal
            {
                type lineUniform;
                axis x;
                start (0 0.205 0.005);
                end (2.2 0.205 0.005);
                nPoints 64;
            }
        }
    }
    probe_1
    {
        type patchProbes;
        libs ("libsampling.so");
        writeControl timeStep;
        writeInterval 1;
        patches (obstacle);
        probeLocations
        (
            (0.15 0.2 0.005)
        );
        fields (p);
    }
    probe_2
    {
        type patchProbes;
        libs ("libsampling.so");
        writeControl timeStep;
        writeInterval 1;
        patches (obstacle);
        probeLocations
        (
            (0.25 0.2 0.005)
        );
        fields (p);
    }
    force_1
    {
        type forceCoeffs;
        libs ("libforces.so");
        patches (obstacle);
        rho rhoInf;
        rhoInf 1;
        magUInf 1;
        lRef 0.1;
        Aref 0.001;
        CofR (0 0 0);
        liftDir (0 1 0);
        dragDir (1 0 0);
        pitchAxis (0 0 1);
        writeControl timeStep;
        writeInterval 1;
    }
    balance_inlet
    {
        type surfaceFieldValue;
        libs ("libfieldFunctionObjects.so");
        writeControl timeStep;
        writeInterval 1;
        log no;
        writeFields no;
        patch inlet;
        operation sum;
        fields (phi);
    }
    balance_outlet
    {
        type surfaceFieldValue;
        libs ("libfieldFunctionObjects.so");
        writeControl timeStep;
        writeInterval 1;
        log no;
        writeFields no;
        patch outlet;
        operation sum;
        fields (phi);
    }
    balance_fixedWalls
    {
        type surfaceFieldValue;
        libs ("libfieldFunctionObjects.so");
        writeControl timeStep;
        writeInterval 1;
        log no;
        writeFields no;
        patch fixedWalls;
        operation sum;
        fields (phi);
    }
    balance_obstacle
    {
        type surfaceFieldValue;
        libs ("libfieldFunctionObjects.so");
        writeControl timeStep;
        writeInterval 1;
        log no;
        writeFields no;
        patch obstacle;
        operation sum;
        fields (phi);
    }
}
