FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}

application pimpleFoam;
startFrom startTime;
startTime 0;
stopAt endTime;
endTime 1.0;
deltaT 0.001;
adjustTimeStep no;
writeControl runTime;
writeInterval 1.0;
purgeWrite 2;
writeFormat ascii;
writePrecision 12;
writeCompression off;
timeFormat general;
timePrecision 12;
runTimeModifiable true;

functions
{
    centreline
    {
        type sets;
        libs (sampling);
        writeControl writeTime;
        setFormat raw;
        interpolationScheme cellPoint;
        fields (U);
        sets
        (
            vertical
            {
                type uniform;
                axis y;
                start (1.1 0 0.005);
                end (1.1 0.41 0.005);
                nPoints 64;
            }
            horizontal
            {
                type uniform;
                axis x;
                start (0 0.205 0.005);
                end (2.2 0.205 0.005);
                nPoints 64;
            }
        );
    }
    probe_1
    {
        type patchProbes;
        libs (sampling);
        writeControl timeStep;
        writeInterval 1;
        patches (obstacle);
        probeLocations
        (
            (0.15 0.2 0.005)
        );
        fields (p);
    }
    probe_2
    {
        type patchProbes;
        libs (sampling);
        writeControl timeStep;
        writeInterval 1;
        patches (obstacle);
        probeLocations
        (
            (0.25 0.2 0.005)
        );
        fields (p);
    }
    force_1
    {
        type forceCoeffs;
        libs (forces);
        patches (obstacle);
        rho rhoInf;
        rhoInf 1;
        magUInf 1;
        lRef 0.1;
        Aref 0.001;
        origin (0 0 0);
        e1 (1 0 0);
        e3 (0 1 0);
        writeControl timeStep;
        writeInterval 1;
    }
    balance_inlet
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        writeControl timeStep;
        writeInterval 1;
        log no;
        writeFields no;
        regionType patch;
        name inlet;
        operation sum;
        fields (phi);
    }
    balance_outlet
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        writeControl timeStep;
        writeInterval 1;
        log no;
        writeFields no;
        regionType patch;
        name outlet;
        operation sum;
        fields (phi);
    }
    balance_fixedWalls
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        writeControl timeStep;
        writeInterval 1;
        log no;
        writeFields no;
        regionType patch;
        name fixedWalls;
        operation sum;
        fields (phi);
    }
    balance_obstacle
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        writeControl timeStep;
        writeInterval 1;
        log no;
        writeFields no;
        regionType patch;
        name obstacle;
        operation sum;
        fields (phi);
    }
}
