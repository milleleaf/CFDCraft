FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}

application simpleFoam;
startFrom startTime;
startTime 0;
stopAt endTime;
endTime 5000.0;
deltaT 1;
writeControl timeStep;
writeInterval 500.0;
purgeWrite 2;
writeFormat ascii;
writePrecision 12;
writeCompression off;
timeFormat general;
timePrecision 12;
runTimeModifiable true;

functions
{
    centreline
    {
        type sets;
        libs (sampling);
        writeControl writeTime;
        setFormat raw;
        interpolationScheme cellPoint;
        fields (U);
        sets
        (
            vertical
            {
                type uniform;
                axis y;
                start (0.05 0 0.025);
                end (0.05 0.1 0.025);
                nPoints 64;
            }
            horizontal
            {
                type uniform;
                axis x;
                start (0 0.05 0.025);
                end (0.1 0.05 0.025);
                nPoints 64;
            }
        );
    }
    probe_1
    {
        type probes;
        libs (sampling);
        writeControl timeStep;
        writeInterval 1;
        probeLocations
        (
            (0.05 0.05 0.025)
        );
        fields (U);
    }
    probe_2
    {
        type probes;
        libs (sampling);
        writeControl timeStep;
        writeInterval 1;
        probeLocations
        (
            (0.025 0.025 0.025)
        );
        fields (U);
    }
    probe_3
    {
        type probes;
        libs (sampling);
        writeControl timeStep;
        writeInterval 1;
        probeLocations
        (
            (0.07500000000000001 0.025 0.025)
        );
        fields (U);
    }
    probe_4
    {
        type probes;
        libs (sampling);
        writeControl timeStep;
        writeInterval 1;
        probeLocations
        (
            (0.025 0.07500000000000001 0.025)
        );
        fields (U);
    }
    probe_5
    {
        type probes;
        libs (sampling);
        writeControl timeStep;
        writeInterval 1;
        probeLocations
        (
            (0.07500000000000001 0.07500000000000001 0.025)
        );
        fields (U);
    }
    balance_movingWall
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        writeControl timeStep;
        writeInterval 1;
        log no;
        writeFields no;
        regionType patch;
        name movingWall;
        operation sum;
        fields (phi);
    }
    balance_fixedWalls
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        writeControl timeStep;
        writeInterval 1;
        log no;
        writeFields no;
        regionType patch;
        name fixedWalls;
        operation sum;
        fields (phi);
    }
}
